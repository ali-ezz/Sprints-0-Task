# Copy this file to .env and fill in the values.
# .env is git-ignored — NEVER commit real credentials.

# --- ServiceNow PDI ---
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# --- Google Gemini (free key from https://aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Service config ---
PORT=8000
# Shared secret the Business Rule sends as the X-Webhook-Secret header.
# Leave blank on both sides to disable the check.
WEBHOOK_SHARED_SECRET=
# Set to "off" to compute the decision and log it WITHOUT writing back to ServiceNow.
SERVICENOW_WRITEBACK=on

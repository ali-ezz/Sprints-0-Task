# ==============================================================================
# Task 0: Agentic Incident Flow — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your credentials and instance details below.
# 3. .env is git-ignored — NEVER commit real credentials or secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ServiceNow PDI (Personal Developer Instance) Settings
# ------------------------------------------------------------------------------
# Instance base URL (REQUIRED).
# Format: https://devXXXXXX.service-now.com (IMPORTANT: no trailing slash).
# Request a free instance at https://developer.servicenow.com.
SERVICENOW_INSTANCE_URL=https://devXXXXXX.service-now.com

# ServiceNow admin username (REQUIRED).
# Default admin user is typically "admin".
SERVICENOW_USERNAME=admin

# Password copied from ServiceNow Developer Portal -> "Manage instance password" (REQUIRED).
# NOTE: Modern ServiceNow releases (Vancouver, Washington, Xanadu+) require the
# 'snc_basic_auth_api_access' role on the user to allow Basic Auth REST API calls.
SERVICENOW_PASSWORD=

# Resolution close code for 'respond' decisions (OPTIONAL, default: "Solution provided").
# When an incident is resolved (state=6), ServiceNow requires a valid close_code.
# Default "Solution provided" is valid on modern instances.
# Query valid codes for your instance with:
# curl -s -u "admin:$SERVICENOW_PASSWORD" \
#   "$SERVICENOW_INSTANCE_URL/api/now/table/sys_choice?sysparm_query=name=incident^element=close_code^language=en&sysparm_fields=value,label"
SERVICENOW_CLOSE_CODE="Solution provided"

# ------------------------------------------------------------------------------
# 2. Google Gemini LLM Settings
# ------------------------------------------------------------------------------
# Google AI Studio API key (REQUIRED).
# Generate a free key at https://aistudio.google.com.
GEMINI_API_KEY=

# Gemini model identifier or alias (OPTIONAL, default: gemini-flash-latest).
# Tracks the latest stable Flash model. Each model ID has its own free daily quota bucket.
# Alternatives: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-1.5-flash.
GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# 3. Webhook Service & Runtime Settings
# ------------------------------------------------------------------------------
# Local TCP port for the FastAPI/Uvicorn server (OPTIONAL, default: 8000).
PORT=8000

# Optional pre-shared secret to authenticate webhook requests from ServiceNow.
# If set, the Business Rule must include the header: X-Webhook-Secret: <value>
# Leave blank on both sides to disable secret validation.
WEBHOOK_SHARED_SECRET=

# ServiceNow write-back mode (OPTIONAL, default: on).
# "on"  -> Compute decisions with Gemini and write back to ServiceNow via Table API PATCH.
# "off" -> Dry-run mode: compute decisions and log them without updating ServiceNow.
SERVICENOW_WRITEBACK=on

# SQLite database file path for idempotency / deduplication (OPTIONAL, default: dedup.sqlite3).
# Ensures duplicate deliveries of the same incident_sys_id are not processed twice (FR5).
DEDUP_DB_PATH=dedup.sqlite3
